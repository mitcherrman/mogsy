# Combat/quiz backend
VITE_COMBAT_API_URL=http://127.0.0.1:8000

# Stripe price IDs (optional overrides — omit to use the live IDs baked into Shop.tsx).
# For test mode, create test-mode prices in the Stripe Dashboard and put their IDs here,
# and set STRIPE_SECRET_KEY (test key) + STRIPE_WEBHOOK_SECRET on Supabase edge functions.
# ---------------------------------------------------------------------------
# PT1.5 — Mogzy Premium commercial offers (SUPABASE EDGE FUNCTION SECRETS, not VITE)
# ---------------------------------------------------------------------------
# These are set on the Supabase project's edge functions, NOT in this file, and
# are read by supabase/functions/_shared/offer-catalog.ts. They are listed here
# only so the full configuration surface is documented in one place.
#
# Every offer grants the SAME Mogzy Premium entitlement — these change the price a
# customer pays, never what they get.
#
#   STRIPE_PRICE_STANDARD_MONTHLY      $9.99/mo   (defaults to the live price)
#   STRIPE_PRICE_STANDARD_ANNUAL       $99.99/yr  (REQUIRED before annual sells)
#   STRIPE_PRICE_LAUNCH_MONTHLY        $7.99/mo   (launch offer)
#   STRIPE_PRICE_LAUNCH_ANNUAL         $79.99/yr  (launch offer)
#   STRIPE_COUPON_WINBACK              server-applied lapsed-customer discount
#
# Founding Playtester — $39.99 first year. UNRESOLVED: what it renews at has
# not been approved, so LEAVE THESE UNSET. With no price configured the offer
# is unpurchasable and never appears on the site.
#   STRIPE_PRICE_FOUNDING_PLAYTESTER   the ANNUAL price it renews at
#   STRIPE_COUPON_FOUNDING_PLAYTESTER  a `duration: once` coupon → $39.99 first year
#   MOGZY_FOUNDING_ACCESS_CODE         secret required to reach the private offer
#
# Whether launch prices are sellable is NOT an env var: it is the
# app_settings.pro_pricing row ({"mode": "standard"} | {"mode": "launch"}),
# which is authority for both the Shop's display and create-checkout.

# PT1.5 retired VITE_STRIPE_PRO_MONTHLY_PRICE_ID, VITE_STRIPE_PRO_ANNUAL_PRICE_ID,
# VITE_STRIPE_LOL_PRO_MONTHLY_PRICE_ID and VITE_STRIPE_WINBACK_COUPON_ID: no
# subscription price or coupon ships in the browser bundle any more. /lol/premium
# and /shop both sell the server-resolved offers above.

# One-time gift and diamond prices (still client-selected, server-allowlisted
# by supabase/functions/_shared/gift-catalog.ts).
VITE_STRIPE_GIFT_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_GIFT_PRO_ANNUAL_PRICE_ID=
VITE_STRIPE_PACK_50_PRICE_ID=
VITE_STRIPE_PACK_200_PRICE_ID=
VITE_STRIPE_PACK_500_PRICE_ID=
VITE_STRIPE_PACK_1500_PRICE_ID=
VITE_STRIPE_PACK_5000_PRICE_ID=

# Advertising (preliminary, provider-neutral — see docs/advertising.md).
# Safe defaults: everything off. VITE_ADS_ENABLED is the global kill switch.
# No Google/AdSense scripts or IDs are involved in any of these flags.
VITE_ADS_ENABLED=false
VITE_THIRD_PARTY_ADS_ENABLED=false
VITE_HOUSE_ADS_ENABLED=false
VITE_AD_PLACEHOLDERS_ENABLED=false
# Optional override for the AdSense publisher ID. When unset, the loader reads
# the account-verification <meta name="google-adsense-account"> in index.html
# (the real, legitimate account: ca-pub-9823769047605421). Missing/invalid
# values fail closed — no ID is ever fabricated. Not a secret.
VITE_ADSENSE_PUBLISHER_ID=
