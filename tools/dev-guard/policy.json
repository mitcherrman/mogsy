{
  "_comment": "Tunable limits for mogzy-guard. Numbers are conservative estimates for a 16 GB / 8-core Windows PC that also runs League of Legends and Firefox; adjust after observing real peaks (see README 'Tuning').",
  "version": 1,
  "lock": {
    "mutexName": "Global\\mogzy-dev-guard-heavy-job",
    "defaultWaitSec": 120,
    "maxWaitSec": 600
  },
  "stateDirEnvDefault": "%LOCALAPPDATA%\\mogzy-dev-guard",
  "resources": {
    "reserveFreeRamMB": 1500,
    "reserveFreeRamMBLeagueClient": 3000,
    "maxCpuPercent": 85,
    "maxCpuPercentLeagueClient": 70,
    "maxDiskBusyPercent": 95,
    "recheckAttempts": 3,
    "recheckIntervalSec": 10
  },
  "league": {
    "inGameProcesses": ["League of Legends"],
    "clientProcesses": ["LeagueClient", "LeagueClientUx", "LeagueClientUxRender"]
  },
  "classes": {
    "vitest":  { "estimateMB": 2500, "workers": 2, "workersLeagueClient": 1, "timeoutSec": 900,  "jobMemoryLimitMB": 6000 },
    "pytest":  { "estimateMB": 1500, "workers": 1, "workersLeagueClient": 1, "timeoutSec": 1200, "jobMemoryLimitMB": 4000 },
    "build":   { "estimateMB": 2500, "workers": 2, "workersLeagueClient": 1, "timeoutSec": 900,  "jobMemoryLimitMB": 6000 },
    "e2e":     { "estimateMB": 3000, "workers": 1, "workersLeagueClient": 1, "timeoutSec": 1200, "jobMemoryLimitMB": 6000 },
    "generic": { "estimateMB": 1500, "workers": 1, "workersLeagueClient": 1, "timeoutSec": 900,  "jobMemoryLimitMB": 4000 }
  },
  "childNodeMaxOldSpaceMB": 2048,
  "_heavyProcessComment": "Command-line patterns (matched only on the listed process names) that count as an UNGUARDED heavy job already running. A new guarded job is blocked while any exist. Dev servers are not heavy; they are only reported by 'status'.",
  "heavyProcessNames": ["node.exe", "python.exe", "py.exe", "bun.exe", "pythonw.exe"],
  "heavyProcessPatterns": [
    "vitest",
    "(^|\\s)-m\\s+(pytest|unittest)\\b",
    "(^|[\\\\/\\s])pytest(\\.exe)?(\\s|$)",
    "playwright[\\\\/ ].*\\btest\\b",
    "_validate\\.py",
    "(^|[\\\\/\\s])validate_[A-Za-z0-9_]+\\.py",
    "vite(\\.js|\\.mjs)?\"?\\s+build\\b",
    "[\\\\/]typescript[\\\\/]bin[\\\\/]tsc\\b",
    "prerender-(items|champions)",
    "remotion\\s+render"
  ]
}
